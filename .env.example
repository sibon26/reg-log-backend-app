# ─────────────────────────────────────────────────────────────────
# Backend Environment Variables – Copy to .env and fill in values
# NEVER commit .env with real credentials
# ─────────────────────────────────────────────────────────────────

# Server
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/auth_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Cookie Authentication
# Generate a strong 256-bit Base64 secret:
#   openssl rand -base64 64
JWT_SECRET=replace_with_strong_base64_secret
JWT_EXPIRATION_MS=1800000
JWT_COOKIE_NAME=access-token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# CORS – exact origin(s) of your frontend (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Brevo SMTP or any SMTP provider)
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login_email
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_FROM=noreply@yourdomain.com

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
